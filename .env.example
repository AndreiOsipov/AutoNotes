# App
PROJECT_NAME=AutoNotes
PROJECT_DESCRIPTION=Web-сервис для конспектирования
PROJECT_VERSION=1.0.0

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=AuteNotes

# JWT
JWT_PRIVATE_KEY_PATH=./certs/private.pem
JWT_PUBLIC_KEY_PATH=./certs/public.pem
JWT_ALGORITHM=RS256

ACCESS_TOKEN_EXPIRES_MINUTES=15
REFRESH_TOKEN_EXPIRES_MINUTES=43200

ACCESS_COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token

SESSION_COOKIE_SECURE=False
SESSION_COOKIE_DOMAIN=

JWT_ISSUER=my-service
JWT_AUDIENCE=my-api
