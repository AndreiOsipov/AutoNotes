# =============================================================================
# Application
# =============================================================================
PROJECT_NAME=AutoNotes
PROJECT_DESCRIPTION=Web-сервис для конспектирования
PROJECT_VERSION=1.0.0

# =============================================================================
# PostgreSQL (service name: db on Docker network "data")
# =============================================================================
POSTGRES_USER=autonotes
POSTGRES_PASSWORD=change-me-use-long-random-secret
POSTGRES_DB=autonotes

# Used by backend in docker-compose.yml (do not use localhost — use hostname "db")
# For local development without Docker, use sqlite or localhost:
# DB=sqlite+aiosqlite:///./database.db
DB=postgresql+asyncpg://autonotes:change-me-use-long-random-secret@db:5432/autonotes

# Run Alembic migrations on container start
RUN_MIGRATIONS=true

# =============================================================================
# JWT (mount ./certs into /app/certs in Docker)
# =============================================================================
JWT_PRIVATE_KEY_PATH=/app/certs/private.pem
JWT_PUBLIC_KEY_PATH=/app/certs/public.pem
JWT_ALGORITHM=RS256

ACCESS_TOKEN_EXPIRES_MINUTES=15
REFRESH_TOKEN_EXPIRES_MINUTES=43200

ACCESS_COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token

# Set True behind HTTPS in production
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_DOMAIN=

JWT_ISSUER=autonotes
JWT_AUDIENCE=autonotes-api

# =============================================================================
# Docker / Compose
# =============================================================================
NGINX_HTTP_PORT=80
# NGINX_HTTPS_PORT=443

# Torch extra for backend image build (cpu | cuda130 | rocm)
TORCH_EXTRA=cpu

# Optional: docker-compose.dev.yml overrides
# POSTGRES_PUBLISH_PORT=5432
# BACKEND_PUBLISH_PORT=8000
